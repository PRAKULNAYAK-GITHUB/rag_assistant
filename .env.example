DATA_DIR=./data
UPLOAD_DIR=./data/uploads
TINYDB_PATH=./data/metadata.json

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks

FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# ── Local Ollama (default) ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=mistral
OLLAMA_TIMEOUT_SECONDS=300

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set to one of: ollama | openai | groq | gemini
# The UI dropdown lets you switch at runtime; this sets the default on startup.
LLM_PROVIDER=ollama

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Groq (fast, free tier available at console.groq.com) ─────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
